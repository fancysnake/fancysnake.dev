---
import { profile, repos } from '../data/profile';
import { fetchArticles } from '../lib/medium';

const articles = await fetchArticles();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name}</title>
    <meta name="description" content={profile.intro} />
    <link rel="canonical" href={Astro.site} />
    <meta name="color-scheme" content="light" />
  </head>
  <body>
    <main>
      <header>
        <h1>{profile.name}</h1>
        <p class="tagline">{profile.tagline}</p>
        <p>{profile.intro}</p>
        <nav>
          {profile.links.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </header>

      <section>
        <h2>Projects</h2>
        <ul class="repos">
          {
            repos.map((repo) => (
              <li>
                <div class="repo-head">
                  {repo.logo && <img src={repo.logo} alt="" width="28" height="28" />}
                  <span class="repo-name">{repo.name}</span>
                </div>
                <p>{repo.blurb}</p>
                <p class="repo-links">
                  <a href={repo.href}>Repo</a>
                  {repo.site && <a href={repo.site.href}>{repo.site.label}</a>}
                  <span class="lang">{repo.language}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      {
        articles.length > 0 && (
          <section>
            <h2>Writing</h2>
            <ul class="articles">
              {articles.map((article) => (
                <li>
                  <a href={article.href}>{article.title}</a>
                  <time datetime={article.date}>{article.date}</time>
                </li>
              ))}
            </ul>
            <p class="more">
              <a href="https://medium.com/@radoslaw_jan">All posts on Medium →</a>
            </p>
          </section>
        )
      }
    </main>
  </body>
</html>

<style>
  :root {
    --bg: #dfe1e8;
    --panel: #fafbff;
    --ink: #08080d;
    --muted: #4c516b;
    --blue: #0a1fe0;
    --neon: #fcee0a;
    --mono: ui-monospace, 'SF Mono', 'Cascadia Mono', Menlo, Consolas, monospace;
    /* Hazard tape — the single most 2077 thing CSS can do for free. */
    --hazard: repeating-linear-gradient(
      -45deg,
      var(--neon) 0 10px,
      var(--ink) 10px 20px
    );
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    color: var(--ink);
    font: 16px/1.55 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
    /* Faint scanlines, not graph paper. */
    background:
      repeating-linear-gradient(
        to bottom,
        rgb(8 8 13 / 4%) 0 1px,
        transparent 1px 3px
      ),
      var(--bg);
  }

  main {
    max-width: 40rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5rem;
  }

  header,
  section {
    position: relative;
    background: var(--panel);
    border: 2px solid var(--ink);
    padding: 1.5rem;
    /* Notched corner — panel, not sheet of paper. */
    clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 0 100%);
  }

  header {
    padding-top: 1.75rem;
  }

  /* Hazard strip across the top of the header. */
  header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 8px;
    background: var(--hazard);
  }

  section {
    margin-top: 1.75rem;
  }

  h1 {
    font-size: clamp(1.75rem, 7vw, 2.5rem);
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.03em;
    /* Chromatic aberration: blue/yellow split, no filter, no JS. */
    text-shadow:
      2px 0 0 var(--neon),
      -2px 0 0 var(--blue);
  }

  h2 {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin: 0 0 1.25rem;
    padding: 0.25rem 0.7rem;
    color: var(--neon);
    background: var(--ink);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 8px 100%, 0 calc(100% - 8px));
  }

  p {
    margin: 0.75rem 0;
  }

  .tagline {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    background: var(--neon);
    padding: 0.15rem 0.5rem;
    margin-top: 0.75rem;
  }

  a {
    color: var(--blue);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  a:hover {
    background: var(--neon);
    color: var(--ink);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  nav a {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--panel);
    background: var(--ink);
    padding: 0.3rem 0.7rem;
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
  }

  nav a:hover {
    color: var(--ink);
    background: var(--neon);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .repos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }

  .repos li {
    background: var(--bg);
    border-left: 4px solid var(--blue);
    padding: 0.7rem 0.7rem 0.75rem;
  }

  .repos li:hover {
    border-left-color: var(--neon);
    background: var(--panel);
  }

  .repo-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .repo-head img {
    flex: none;
  }

  .repo-name {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }

  .repos p {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .repo-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin-top: 0.5rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .lang {
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .articles li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--bg);
  }

  .articles li:last-child {
    border-bottom: 0;
  }

  .articles time {
    flex: none;
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .more {
    margin-top: 1rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  @media (max-width: 30rem) {
    header,
    section {
      padding: 1.15rem;
    }
  }

  /* The aberration and stripes are decoration; drop the motion-adjacent parts. */
  @media (prefers-reduced-motion: reduce) {
    h1 {
      text-shadow: none;
    }
  }
</style>
