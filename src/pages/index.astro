---
import { profile, repos } from '../data/profile';
import { fetchArticles } from '../lib/medium';

const articles = await fetchArticles();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name}</title>
    <meta name="description" content={profile.intro} />
    <link rel="canonical" href={Astro.site} />
    <meta name="color-scheme" content="light" />
  </head>
  <body>
    <main>
      <header>
        <h1>{profile.name}</h1>
        <p class="tagline">{profile.tagline}</p>
        <p>{profile.intro}</p>
        <nav>
          {profile.links.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </header>

      <section>
        <h2>Projects</h2>
        <ul class="repos">
          {
            repos.map((repo) => (
              <li>
                <div class="repo-head">
                  {repo.logo && <img src={repo.logo} alt="" width="28" height="28" />}
                  <span class="repo-name">{repo.name}</span>
                </div>
                <p>{repo.blurb}</p>
                <p class="repo-links">
                  <a href={repo.href}>Repo</a>
                  {repo.site && <a href={repo.site.href}>{repo.site.label}</a>}
                  <span class="lang">{repo.language}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      {
        articles.length > 0 && (
          <section>
            <h2>Writing</h2>
            <ul class="articles">
              {articles.map((article) => (
                <li>
                  <a href={article.href}>{article.title}</a>
                  <time datetime={article.date}>{article.date}</time>
                </li>
              ))}
            </ul>
            <p class="more">
              <a href="https://medium.com/@radoslaw_jan">All posts on Medium →</a>
            </p>
          </section>
        )
      }
    </main>
  </body>
</html>

<style>
  :root {
    --bg: #fcfcfd;
    --fg: #12131a;
    --muted: #5b6070;
    --rule: #e6e7ec;
    --blue: #1a3cff;
    --neon: #ffe500;
    --mono: ui-monospace, 'SF Mono', 'Cascadia Mono', Menlo, Consolas, monospace;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.6 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  main {
    max-width: 38rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }

  h1 {
    font-size: clamp(1.75rem, 6vw, 2.25rem);
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.02em;
  }

  h2 {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--blue);
    margin: 0 0 1.25rem;
  }

  /* Yellow is low-contrast on white, so the bar earns its presence by area. */
  h2::before {
    content: '';
    display: inline-block;
    width: 2rem;
    height: 9px;
    background: var(--neon);
    vertical-align: 0.05em;
    margin-right: 0.6rem;
  }

  p {
    margin: 0.75rem 0;
  }

  .tagline {
    font-family: var(--mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--blue);
    margin-top: 0.5rem;
  }

  a {
    color: var(--blue);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  a:hover {
    background: var(--neon);
    color: var(--fg);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.25rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  section {
    margin-top: 3rem;
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .repos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .repos li {
    border-left: 6px solid var(--neon);
    padding-left: 0.75rem;
  }

  .repos li:hover {
    border-left-color: var(--blue);
  }

  .repo-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .repo-head img {
    flex: none;
  }

  .repo-name {
    font-family: var(--mono);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .repos p {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .repo-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.85rem;
    margin-top: 0.4rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .lang {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .articles li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.55rem 0;
  }

  .articles time {
    flex: none;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .more {
    margin-top: 1rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
  }
</style>
