---
import { categories, profile, repos } from '../data/profile';
import { fetchArticles } from '../lib/medium';

const tiles = categories.map((label) => ({
  label,
  repos: repos.filter((repo) => repo.category === label),
}));
const articles = await fetchArticles();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name}</title>
    <meta name="description" content={profile.intro} />
    <link rel="canonical" href={Astro.site} />
    <meta name="color-scheme" content="light" />
  </head>
  <body>
    <main>
      <header>
        <div class="bio">
          <h1>{profile.name}</h1>
          <p class="tagline">{profile.tagline}</p>
          <p>{profile.intro}</p>
        </div>
        <nav aria-label="Elsewhere">
          {
            profile.links.map((link) => (
              <a href={link.href} aria-label={link.label} title={link.label}>
                <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
                  <path d={link.icon} />
                </svg>
              </a>
            ))
          }
        </nav>
      </header>

      <div class="tiles">
        {
          tiles.map((tile) => (
            <section>
              <h2>{tile.label}</h2>
              <ul class="repos">
                {tile.repos.map((repo) => (
                  <li style={`border-left-color: ${repo.color}`}>
                    <div class="repo-head">
                      {repo.logo && <img src={repo.logo} alt="" width="28" height="28" />}
                      <span class="repo-name">{repo.name}</span>
                    </div>
                    <p>{repo.blurb}</p>
                    <p class="repo-links">
                      <a href={repo.href}>Repo</a>
                      {repo.site && <a href={repo.site.href}>{repo.site.label}</a>}
                      <span class="lang">{repo.language}</span>
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }

        {
          articles.length > 0 && (
            <section>
              <h2>Writing</h2>
              <ul class="articles">
                {articles.map((article) => (
                  <li>
                    <a href={article.href}>{article.title}</a>
                    <time datetime={article.date}>{article.date}</time>
                  </li>
                ))}
              </ul>
              <p class="more">
                <a href="https://medium.com/@radoslaw_jan">All posts on Medium →</a>
              </p>
            </section>
          )
        }
      </div>
    </main>
  </body>
</html>

<style>
  :root {
    --bg: #fcfcfd;
    --fg: #12131a;
    --muted: #5b6070;
    --rule: #e6e7ec;
    --teal: #1f9999;
    --purple: #7c29aa;
    --orange: #ff8f33;
    --yellow: #ffe500;
    --mono: ui-monospace, 'SF Mono', 'Cascadia Mono', Menlo, Consolas, monospace;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.6 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  main {
    max-width: 80rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem 3rem;
  }

  /* Prose keeps a reading measure; the tiles below take the full width. */
  .bio {
    max-width: 38rem;
  }

  h1 {
    font-size: clamp(1.75rem, 6vw, 2.25rem);
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.02em;
  }

  h2 {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--teal);
    margin: 0 0 1.25rem;
  }

  /* Yellow is low-contrast on white, so the bar earns its presence by area. */
  h2::before {
    content: '';
    display: inline-block;
    width: 2rem;
    height: 9px;
    background: var(--yellow);
    vertical-align: 0.05em;
    margin-right: 0.6rem;
  }

  p {
    margin: 0.75rem 0;
  }

  .tagline {
    font-family: var(--mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--teal);
    margin-top: 0.5rem;
  }

  a {
    color: var(--teal);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  a:hover {
    background: var(--orange);
    color: var(--fg);
  }

  nav {
    display: flex;
    gap: 0.25rem;
    margin-top: 0.35rem;
  }

  nav a {
    display: block;
    padding: 0.4rem;
    line-height: 0;
  }

  nav svg {
    fill: currentColor;
  }

  /* One tile per category; as many across as fit the viewport. */
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.5rem 2.5rem;
    margin-top: 3rem;
  }

  section {
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .repos {
    display: grid;
    gap: 1.25rem;
  }

  /* Bar colour comes from the repo's own entry in profile.ts. */
  .repos li {
    border-left: 6px solid var(--yellow);
    padding-left: 0.75rem;
  }

  .repo-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .repo-head img {
    flex: none;
  }

  .repo-name {
    font-family: var(--mono);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .repos p {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .repo-links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.85rem;
    margin-top: 0.4rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .lang {
    color: var(--muted);
    font-size: 0.75rem;
  }

  /* Titles are long and the tile is narrow: date sits under the title. */
  .articles li {
    display: grid;
    gap: 0.15rem;
    padding: 0.55rem 0;
  }

  .articles time {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .more {
    margin-top: 1rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
  }
</style>
